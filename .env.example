# Qanoni Audio Pro
# Local and Vercel environment template. Never commit real secrets.

# Use a hosted PostgreSQL connection for Vercel/production.
# Example format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

AUTH_SECRET="replace-with-a-long-random-32-byte-secret"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH=""

# Production uploads: Vercel Blob keeps runtime uploads persistent on Vercel.
BLOB_READ_WRITE_TOKEN=""
NEXT_PUBLIC_VERCEL_BLOB_ENABLED="false"

NEXT_PUBLIC_APP_NAME="Qanoni Audio"
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"
