# Qanoni Audio Pro
# Copy this file to .env.local for local development.
# NEVER commit real secrets.

# IMPORTANT:
# For Vercel, use a hosted PostgreSQL database such as Prisma Postgres or Neon.
# Do NOT use localhost in production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# 32+ byte random secret. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-secret"

ADMIN_EMAIL="your-admin-email@example.com"
# Generate with:
# node scripts/generate-admin-hash.cjs "YourStrongPassword"
ADMIN_PASSWORD_HASH=""

# Vercel Blob for persistent cover/audio uploads in production.
BLOB_READ_WRITE_TOKEN=""
NEXT_PUBLIC_VERCEL_BLOB_ENABLED="false"

NEXT_PUBLIC_APP_NAME="Qanoni Audio"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
